# Secrets never enter the build context or the image.
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key

# Installed / generated in the image.
node_modules
web-demo/dist

# Not needed to build or run the playground.
.git
.gitignore
.impeccable
docs
*.md
!web-demo/samples/**/*.md
**/*.test.ts
web-demo/server/testing
web-demo/scripts/dev-mock.ts
coverage
*.log
.DS_Store

# Sample repos are served to visitors as-is, test files included.
!web-demo/samples/**
