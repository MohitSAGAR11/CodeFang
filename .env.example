# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug exactly as OpenRouter lists it, e.g. openrouter/auto
OPENROUTER_DEFAULT_MODEL=

# Required for Telegram mode only
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional — unlocks web_search / web_crawl / fetch_url
FIRECRAWL_API_KEY=

# Optional — extra SKILL.md roots, separated by ;
SKILLS_DIRS=
